Start:
--TEST BLENDING 3: MovL con WaitFinish{Percent=...} prima delle istruzioni non di moto
--Ogni prova: da home 6 MovL da 20 mm lungo +X poi ritorno in home. Messaggio sul PAD a ogni prova.
--PROVA E: MovL + WaitFinish 0 + assegnazione INT
--PROVA F: MovL + WaitFinish 50 + assegnazione INT
--PROVA G: MovL dentro IF + WaitFinish 0 (come la teleoperazione)
--PROVA H: TARGET += 20 + MovL TARGET + WaitFinish 0 (schema della teleoperazione)
t_p.I_MOSSO.value = 1
MovJ{P=t_g.pose_home}
Wait{T=1000}
--PROVA E
SetRtInfo{msg="PROVA E WAITFINISH 0",eid=70003}
MovL{P=t_p.PB1,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB2,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB3,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB4,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB5,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB6,V=t_s.V100,B="FINE"}
Wait{T=1500}
MovJ{P=t_g.pose_home}
Wait{T=1500}
--PROVA F
SetRtInfo{msg="PROVA F WAITFINISH 50",eid=70003}
MovL{P=t_p.PB1,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=50}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB2,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=50}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB3,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=50}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB4,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=50}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB5,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=50}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB6,V=t_s.V100,B="FINE"}
Wait{T=1500}
MovJ{P=t_g.pose_home}
Wait{T=1500}
--PROVA G
SetRtInfo{msg="PROVA G IF + WAITFINISH 0",eid=70003}
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB1,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
    WaitFinish{Percent=0}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB2,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
    WaitFinish{Percent=0}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB3,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
    WaitFinish{Percent=0}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB4,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
    WaitFinish{Percent=0}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB5,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
    WaitFinish{Percent=0}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB6,V=t_s.V100,B="FINE"}
ENDIF
Wait{T=1500}
MovJ{P=t_g.pose_home}
Wait{T=1500}
--PROVA H
SetRtInfo{msg="PROVA H TARGET + WAITFINISH 0",eid=70003}
t_g.TARGET = t_g.pose_home
t_g.TARGET.x = t_g.TARGET.x + 20
MovL{P=t_g.TARGET,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_g.TARGET.x = t_g.TARGET.x + 20
MovL{P=t_g.TARGET,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_g.TARGET.x = t_g.TARGET.x + 20
MovL{P=t_g.TARGET,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_g.TARGET.x = t_g.TARGET.x + 20
MovL{P=t_g.TARGET,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_g.TARGET.x = t_g.TARGET.x + 20
MovL{P=t_g.TARGET,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
WaitFinish{Percent=0}
t_g.TARGET.x = t_g.TARGET.x + 20
MovL{P=t_g.TARGET,V=t_s.V100,B="FINE"}
Wait{T=1500}
MovJ{P=t_g.pose_home}
Wait{T=1500}
SetRtInfo{msg="TEST BLENDING 3 FINITO",eid=70003}
End;
