Start:
--TEST BLENDING 2: punti PB1..PB6 gia' scritti nelle variabili (nessun calcolo durante il moto)
--Ogni prova: da home 6 MovL da 20 mm lungo +X poi ritorno in home. Messaggio sul PAD a ogni prova.
--PROVA A: MovL uno dopo l'altro senza altre istruzioni in mezzo (ABSOLUTE C10)
--PROVA B: come A ma con Z_COST (vConst = 1)
--PROVA C: come A con un'assegnazione INT tra un MovL e il successivo
--PROVA D: come A con ogni MovL dentro un IF (come nella teleoperazione)
t_p.I_MOSSO.value = 1
MovJ{P=t_g.pose_home}
Wait{T=1000}
--PROVA A
SetRtInfo{msg="PROVA A",eid=70003}
MovL{P=t_p.PB1,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
MovL{P=t_p.PB2,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
MovL{P=t_p.PB3,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
MovL{P=t_p.PB4,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
MovL{P=t_p.PB5,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
MovL{P=t_p.PB6,V=t_s.V100,B="FINE"}
Wait{T=1500}
MovJ{P=t_g.pose_home}
Wait{T=1500}
--PROVA B
SetRtInfo{msg="PROVA B",eid=70003}
MovL{P=t_p.PB1,V=t_s.V100,B="ABSOLUTE",C=t_p.Z_COST}
MovL{P=t_p.PB2,V=t_s.V100,B="ABSOLUTE",C=t_p.Z_COST}
MovL{P=t_p.PB3,V=t_s.V100,B="ABSOLUTE",C=t_p.Z_COST}
MovL{P=t_p.PB4,V=t_s.V100,B="ABSOLUTE",C=t_p.Z_COST}
MovL{P=t_p.PB5,V=t_s.V100,B="ABSOLUTE",C=t_p.Z_COST}
MovL{P=t_p.PB6,V=t_s.V100,B="FINE"}
Wait{T=1500}
MovJ{P=t_g.pose_home}
Wait{T=1500}
--PROVA C
SetRtInfo{msg="PROVA C",eid=70003}
MovL{P=t_p.PB1,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB2,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB3,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB4,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB5,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
t_p.I_MOSSO.value = 1
MovL{P=t_p.PB6,V=t_s.V100,B="FINE"}
Wait{T=1500}
MovJ{P=t_g.pose_home}
Wait{T=1500}
--PROVA D
SetRtInfo{msg="PROVA D",eid=70003}
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB1,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB2,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB3,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB4,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB5,V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
ENDIF
IF t_p.I_MOSSO.value == 1 THEN
    MovL{P=t_p.PB6,V=t_s.V100,B="FINE"}
ENDIF
Wait{T=1500}
MovJ{P=t_g.pose_home}
Wait{T=1500}
SetRtInfo{msg="TEST BLENDING 2 FINITO",eid=70003}
End;
