Start:
--TELEOP COMUNICAZIONE: gira in parallelo (lanciato con RUN da Teleop_Gesti)
--Solo socket e NESSUN movimento (vincolo di RUN). Un ciclo ogni ~200 ms:
--"REQ" -> parola -> codice in t_p.I_CMD (letto dal programma di moto)
--left=1 right=2 forward=3 backward=4 up=5 down=6 stop=7 quit=8 open=9 close=10
--0 = timeout o parola sconosciuta (il moto si ferma)
--t_p.I_CommStato: 0 = in connessione | 1 = connesso | -1 = errore
--Con "quit" o errore di connessione mette TELEOP = 0 e chiude il socket.
SocketCreate{socketName=t_p.Com_PC,IP=t_p.S_IP_PC.value,Port=t_p.I_Porta_PC.value,Ret=t_p.I_StatoCom}
IF t_p.I_StatoCom.value == 0 THEN
    SetRtInfo{msg="TELEOP GESTI CONNESSO",eid=70003}
    t_p.I_CommStato.value = 1
ELSE
    SetRtInfo{msg="ERRORE CONNESSIONE PC",eid=70002}
    t_p.TELEOP.value = 0
    t_p.I_CommStato.value = -1
ENDIF
WHILE t_p.TELEOP.value == 1 DO
    t_p.S_Rx.value = t_p.S_Vuota.value
    SocketResetBuf{socketName=t_p.Com_PC}
    SocketSendStr{socketName=t_p.Com_PC,stringData="REQ",Ret=t_p.I_StatoMess}
    SocketReadStr{socketName=t_p.Com_PC,StrValue=t_p.S_Rx,WTime=1000,Ret=t_p.I_StatoRisposta}
    --Decodifica in I_RX, poi UNA sola scrittura di I_CMD (il moto non vede valori intermedi)
    t_p.I_RX.value = 0
    IF t_p.I_StatoRisposta.value == 0 THEN
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_LEFT.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 1
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_RIGHT.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 2
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_FWD.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 3
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_BACK.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 4
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_UP.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 5
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_DOWN.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 6
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_STOP.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 7
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_QUIT.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 8
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_OPEN.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 9
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_CLOSE.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_RX.value = 10
        ENDIF
        IF t_p.I_RX.value == 0 THEN
            SetRtInfo{msg="COMANDO SCONOSCIUTO",eid=70003}
        ENDIF
    ELSE
        SetRtInfo{msg="TIMEOUT PC",eid=70003}
    ENDIF
    t_p.I_CMD.value = t_p.I_RX.value
    IF t_p.I_RX.value == 8 THEN
        t_p.TELEOP.value = 0
    ENDIF
    --Timeout/sconosciuto: pausa breve prima di riprovare
    IF t_p.I_RX.value == 0 THEN
        Wait{T=100}
    ENDIF
ENDWHILE
IF t_p.I_StatoCom.value == 0 THEN
    SocketClose{socketName=t_p.Com_PC,Ret=t_p.I_StatoCom}
ENDIF
End;
