--
--PROVA 4
SetRtInfo{msg="PROVA 4 UN SOLO MOVL",eid=70003}
t_g.TARGET = t_g.pose_home
t_g.TARGET.x = t_g.TARGET.x + 120
MovL{P=t_g.TARGET,V=t_s.V100,B="FINE",C=t_s.C10}
Wait{T=1500}
MovJ{P=t_g.pose_home}
SetRtInfo{msg="TEST BLENDING FINITO",eid=70003}
End;
