Start:
--=== TELEOPERAZIONE A COMANDI (jog) - robot = client TCP,
--Ciclo: il robot manda "REQ", il PC risponde con UNA parola:
--left right forward backward up down stop quit open close
--Ogni parola di direzione = un MovLRel di R_PASSO mm in terna base (COORD),
--V100 + blending ABSOLUTE C10 (zona = meta' passo): il robot non si ferma se il comando dopo arriva in tempo.
--Limiti: contatori di passi da home (I_NX, I_NY, I_NZ), controllati PRIMA del moto.
--Variabili di progetto (t_p) da creare nell'Editor:
--Com_PC (Socket)  S_IP_PC (STRING)  I_Porta_PC (INT)
--I_StatoCom, I_StatoMess, I_StatoRisposta, I_Risultato, I_CMD, TELEOP, PINZA_ATT (INT)
--S_Rx, S_Vuota, S_LEFT, S_RIGHT, S_FWD, S_BACK, S_UP, S_DOWN,
--S_STOP, S_QUIT, S_OPEN, S_CLOSE (STRING, valore = la parola)
--R_PASSO (REAL)  D_LEFT, D_RIGHT, D_FWD, D_BACK, D_UP, D_DOWN (DCPOS)
--I_NX, I_NY, I_NZ, NX_MIN, NX_MAX, NY_MIN, NY_MAX, NZ_MIN, NZ_MAX (INT)
--Globali gia' esistenti: G:pose_home (CPOS), G:Gripper (DO)
--==
--Controller virtuale: "127.0.0.1" | Robot reale: IP del PC sulla rete del robot
t_p.S_IP_PC.value = "127.0.0.1"
t_p.I_Porta_PC.value = 9500
--Passo [mm]. Se cambia, ricalcolare i limiti in passi (limite in mm / R_PASSO)
t_p.R_PASSO.value = 20.0
--Limiti in passi da home (verificare col PAD!)
--X ~254..434 mm, Y ~-86..134 mm, Z ~111..231 mm con R_PASSO = 20 (da home niente up)
t_p.NX_MIN.value = -1
t_p.NX_MAX.value = 8
t_p.NY_MIN.value = -5
t_p.NY_MAX.value = 6
t_p.NZ_MIN.value = -6
t_p.NZ_MAX.value = 0
--=== Passi cartesiani (DCPOS,
--Scritti tutti e tre i campi dx, dy, dz di ogni DCPOS (da, db, dc restano 0)
t_p.D_FWD.dx = t_p.R_PASSO.value
t_p.D_FWD.dy = 0
t_p.D_FWD.dz = 0
t_p.D_BACK.dx = -t_p.R_PASSO.value
t_p.D_BACK.dy = 0
t_p.D_BACK.dz = 0
t_p.D_LEFT.dx = 0
t_p.D_LEFT.dy = t_p.R_PASSO.value
t_p.D_LEFT.dz = 0
t_p.D_RIGHT.dx = 0
t_p.D_RIGHT.dy = -t_p.R_PASSO.value
t_p.D_RIGHT.dz = 0
t_p.D_UP.dx = 0
t_p.D_UP.dy = 0
t_p.D_UP.dz = t_p.R_PASSO.value
t_p.D_DOWN.dx = 0
t_p.D_DOWN.dy = 0
t_p.D_DOWN.dz = -t_p.R_PASSO.value
--==
t_p.I_NX.value = 0
t_p.I_NY.value = 0
t_p.I_NZ.value = 0
t_p.TELEOP.value = 1
t_p.PINZA_ATT.value = 1
MovJ{P=t_g.pose_home}
SetDO{IO=t_g.Gripper,Val=1}
Wait{T=500}
--==
SocketCreate{socketName=t_p.Com_PC,IP=t_p.S_IP_PC.value,Port=t_p.I_Porta_PC.value,Ret=t_p.I_StatoCom}
IF t_p.I_StatoCom.value == 0 THEN
    SetRtInfo{msg="TELEOP GESTI CONNESSO",eid=70003}
ELSE
    SetRtInfo{msg="ERRORE CONNESSIONE PC",eid=70002}
    t_p.TELEOP.value = 0
ENDIF
--==
WHILE t_p.TELEOP.value == 1 DO
    --Richiesta del comando corrente
    t_p.S_Rx.value = t_p.S_Vuota.value
    SocketResetBuf{socketName=t_p.Com_PC}
    SocketSendStr{socketName=t_p.Com_PC,stringData="REQ",Ret=t_p.I_StatoMess}
    SocketReadStr{socketName=t_p.Com_PC,StrValue=t_p.S_Rx,WTime=1000,Ret=t_p.I_StatoRisposta}
    --Decodifica: 0 = timeout o parola sconosciuta
    t_p.I_CMD.value = 0
    IF t_p.I_StatoRisposta.value == 0 THEN
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_LEFT.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 1
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_RIGHT.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 2
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_FWD.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 3
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_BACK.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 4
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_UP.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 5
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_DOWN.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 6
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_STOP.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 7
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_QUIT.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 8
            t_p.TELEOP.value = 0
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_OPEN.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 9
        ENDIF
        t_p.I_Risultato.value = strcmp ( t_p.S_Rx.value , t_p.S_CLOSE.value )
        IF t_p.I_Risultato.value == 0 THEN
            t_p.I_CMD.value = 10
        ENDIF
    ENDIF
    --Esecuzione. Nei rami di moto NESSUN Wait: romperebbe il blending.
    --Chiavi B= (BlendType) e C= (BlendValue) prese dal manuale (MovLRel P T [V] [B] [C]):
    --DA VERIFICARE nell'Editor prima di usarlo sul robot.
    IF t_p.I_CMD.value == 1 THEN
        IF t_p.I_NY.value < t_p.NY_MAX.value THEN
            MovLRel{P=t_p.D_LEFT,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NY.value = t_p.I_NY.value + 1
        ENDIF
    ENDIF
    IF t_p.I_CMD.value == 2 THEN
        IF t_p.I_NY.value > t_p.NY_MIN.value THEN
            MovLRel{P=t_p.D_RIGHT,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NY.value = t_p.I_NY.value - 1
        ENDIF
    ENDIF
    IF t_p.I_CMD.value == 3 THEN
        IF t_p.I_NX.value < t_p.NX_MAX.value THEN
            MovLRel{P=t_p.D_FWD,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NX.value = t_p.I_NX.value + 1
        ENDIF
    ENDIF
    IF t_p.I_CMD.value == 4 THEN
        IF t_p.I_NX.value > t_p.NX_MIN.value THEN
            MovLRel{P=t_p.D_BACK,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NX.value = t_p.I_NX.value - 1
        ENDIF
    ENDIF
    IF t_p.I_CMD.value == 5 THEN
        IF t_p.I_NZ.value < t_p.NZ_MAX.value THEN
            MovLRel{P=t_p.D_UP,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NZ.value = t_p.I_NZ.value + 1
        ENDIF
    ENDIF
    IF t_p.I_CMD.value == 6 THEN
        IF t_p.I_NZ.value > t_p.NZ_MIN.value THEN
            MovLRel{P=t_p.D_DOWN,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NZ.value = t_p.I_NZ.value - 1
        ENDIF
    ENDIF
    --Pinza: solo sul cambio di stato (SetDO/Wait fermano il moto: accettabile)
    IF t_p.I_CMD.value == 9 THEN
        IF t_p.PINZA_ATT.value == 0 THEN
            SetDO{IO=t_g.Gripper,Val=1}
            t_p.PINZA_ATT.value = 1
            Wait{T=300}
        ENDIF
    ENDIF
    IF t_p.I_CMD.value == 10 THEN
        IF t_p.PINZA_ATT.value == 1 THEN
            SetDO{IO=t_g.Gripper,Val=0}
            t_p.PINZA_ATT.value = 0
            Wait{T=300}
        ENDIF
    ENDIF
    --Stop: fermo, breve attesa per non martellare il PC
    IF t_p.I_CMD.value == 7 THEN
        Wait{T=50}
    ENDIF
    --Timeout o parola sconosciuta
    IF t_p.I_CMD.value == 0 THEN
        IF t_p.I_StatoRisposta.value == 0 THEN
            SetRtInfo{msg="COMANDO SCONOSCIUTO",eid=70003}
        ELSE
            SetRtInfo{msg="TIMEOUT PC",eid=70003}
        ENDIF
        Wait{T=50}
    ENDIF
ENDWHILE
--==
IF t_p.I_StatoCom.value == 0 THEN
    SocketClose{socketName=t_p.Com_PC,Ret=t_p.I_StatoCom}
ENDIF
MovJ{P=t_g.pose_home}
End;
