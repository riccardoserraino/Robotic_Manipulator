Start:
--TELEOPERAZIONE A COMANDI (jog): programma di MOTO
--Il socket e' nel programma parallelo Teleop_Comm (RUN): qui NESSUNA istruzione socket
--cosi' tra un MovLRel e il successivo il controller puo' raccordare (blending).
--Teleop_Comm scrive il comando corrente in t_p.I_CMD:
--1 left  2 right  3 forward  4 backward  5 up  6 down  7 stop  8 quit  9 open  10 close  0 nessuno
--Ogni direzione = un MovLRel di R_PASSO mm in terna base (COORD) a V100 con blending ABSOLUTE C10.
--Limiti: contatori di passi da home (I_NX I_NY I_NZ) controllati PRIMA del moto.
--CONFIGURAZIONE
--Controller virtuale: "127.0.0.1" | Robot reale: IP del PC sulla rete del robot
t_p.S_IP_PC.value = "127.0.0.1"
t_p.I_Porta_PC.value = 9500
--Passo [mm]. Se cambia ricalcolare i limiti in passi (limite in mm / R_PASSO)
t_p.R_PASSO.value = 20.0
--Limiti in passi da home (verificare col PAD!)
--X ~254..434 mm  Y ~-86..134 mm  Z ~111..231 mm con R_PASSO = 20 (da home niente up)
t_p.NX_MIN.value = -1
t_p.NX_MAX.value = 8
t_p.NY_MIN.value = -5
t_p.NY_MAX.value = 6
t_p.NZ_MIN.value = -6
t_p.NZ_MAX.value = 0
--PASSI CARTESIANI (DCPOS in terna base): scritti dx dy dz di ognuna
t_p.D_FWD.dx = t_p.R_PASSO.value
t_p.D_FWD.dy = 0
t_p.D_FWD.dz = 0
t_p.D_BACK.dx = -t_p.R_PASSO.value
t_p.D_BACK.dy = 0
t_p.D_BACK.dz = 0
t_p.D_LEFT.dx = 0
t_p.D_LEFT.dy = t_p.R_PASSO.value
t_p.D_LEFT.dz = 0
t_p.D_RIGHT.dx = 0
t_p.D_RIGHT.dy = -t_p.R_PASSO.value
t_p.D_RIGHT.dz = 0
t_p.D_UP.dx = 0
t_p.D_UP.dy = 0
t_p.D_UP.dz = t_p.R_PASSO.value
t_p.D_DOWN.dx = 0
t_p.D_DOWN.dy = 0
t_p.D_DOWN.dz = -t_p.R_PASSO.value
--STATO INIZIALE
t_p.I_NX.value = 0
t_p.I_NY.value = 0
t_p.I_NZ.value = 0
t_p.I_CMD.value = 0
t_p.I_CommStato.value = 0
t_p.TELEOP.value = 1
t_p.PINZA_ATT.value = 1
MovJ{P=t_g.pose_home}
SetDO{IO=t_g.Gripper,Val=1}
Wait{T=500}
--AVVIO COMUNICAZIONE IN PARALLELO e attesa della connessione
RUN Teleop_Comm
WHILE t_p.I_CommStato.value == 0 DO
    Wait{T=50}
ENDWHILE
--CICLO DI MOTO
WHILE t_p.TELEOP.value == 1 DO
    --Copia del comando: Teleop_Comm puo' cambiarlo in qualsiasi momento
    t_p.I_MOSSA.value = t_p.I_CMD.value
    t_p.I_MOSSO.value = 0
    --Nei rami di moto NESSUN Wait: romperebbe il blending
    IF t_p.I_MOSSA.value == 1 THEN
        IF t_p.I_NY.value < t_p.NY_MAX.value THEN
            MovLRel{P=t_p.D_LEFT,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NY.value = t_p.I_NY.value + 1
            t_p.I_MOSSO.value = 1
        ENDIF
    ENDIF
    IF t_p.I_MOSSA.value == 2 THEN
        IF t_p.I_NY.value > t_p.NY_MIN.value THEN
            MovLRel{P=t_p.D_RIGHT,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NY.value = t_p.I_NY.value - 1
            t_p.I_MOSSO.value = 1
        ENDIF
    ENDIF
    IF t_p.I_MOSSA.value == 3 THEN
        IF t_p.I_NX.value < t_p.NX_MAX.value THEN
            MovLRel{P=t_p.D_FWD,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NX.value = t_p.I_NX.value + 1
            t_p.I_MOSSO.value = 1
        ENDIF
    ENDIF
    IF t_p.I_MOSSA.value == 4 THEN
        IF t_p.I_NX.value > t_p.NX_MIN.value THEN
            MovLRel{P=t_p.D_BACK,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NX.value = t_p.I_NX.value - 1
            t_p.I_MOSSO.value = 1
        ENDIF
    ENDIF
    IF t_p.I_MOSSA.value == 5 THEN
        IF t_p.I_NZ.value < t_p.NZ_MAX.value THEN
            MovLRel{P=t_p.D_UP,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NZ.value = t_p.I_NZ.value + 1
            t_p.I_MOSSO.value = 1
        ENDIF
    ENDIF
    IF t_p.I_MOSSA.value == 6 THEN
        IF t_p.I_NZ.value > t_p.NZ_MIN.value THEN
            MovLRel{P=t_p.D_DOWN,T="COORD",V=t_s.V100,B="ABSOLUTE",C=t_s.C10}
            t_p.I_NZ.value = t_p.I_NZ.value - 1
            t_p.I_MOSSO.value = 1
        ENDIF
    ENDIF
    --Pinza: solo sul cambio di stato (SetDO/Wait fermano il moto: accettabile)
    IF t_p.I_MOSSA.value == 9 THEN
        IF t_p.PINZA_ATT.value == 0 THEN
            SetDO{IO=t_g.Gripper,Val=1}
            t_p.PINZA_ATT.value = 1
            Wait{T=300}
        ENDIF
    ENDIF
    IF t_p.I_MOSSA.value == 10 THEN
        IF t_p.PINZA_ATT.value == 1 THEN
            SetDO{IO=t_g.Gripper,Val=0}
            t_p.PINZA_ATT.value = 0
            Wait{T=300}
        ENDIF
    ENDIF
    --Nessun moto (stop / limite raggiunto / timeout): pausa breve per non girare a vuoto
    IF t_p.I_MOSSO.value == 0 THEN
        Wait{T=20}
    ENDIF
ENDWHILE
--CHIUSURA: il socket lo chiude Teleop_Comm quando TELEOP = 0
MovJ{P=t_g.pose_home}
End;
